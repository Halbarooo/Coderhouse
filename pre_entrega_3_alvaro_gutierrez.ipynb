# ==========================================
# BLOQUE 1: INGESTA DE DATOS
# ==========================================
import pandas as pd
df = pd.read_csv("/content/drive/MyDrive/Coderhouse/Data Science I/Dataset LOL Coderhouse/MatchStatsTbl.csv")
display(df.head())

# ==========================================
# BLOQUE 2: RADIOGRAFÍA TÉCNICA
# ==========================================
print(f"Dimensiones del dataset: {df.shape}")
df.info()
df.describe()
display(df.isnull().sum())

# ==========================================
# BLOQUE 3: LIMPIEZA DE DATOS
# ==========================================
# Eliminar filas con valor UNKNWOWN en campo Lane

print("Descripción anterior:", df["Lane"].unique())
print("Registros antes de limpieza:", len(df))


# Renombrar los valores de la columna Lane
df["Lane"] = df["Lane"].apply(
    lambda x: "SUPPORT" if x == "UTILITY"
    else "ADC" if x == "BOTTOM"
    else x.title().upper()
    )

# Poner como nulo los casos con valor UNKNOWN
df["Lane"] = df["Lane"].where(df["Lane"] != "UNKNOWN")

# Eliminar registros vacíos generados
df = df.dropna(subset=["Lane"]).reset_index(drop=True)

print("Descripción actual:", df["Lane"].unique())
print("Registros después de limpieza:", len(df))
# Eliminacion de columnas nulas y duplicados por MatchStatsId
df = df.dropna().drop_duplicates(subset=df.columns.difference(["MatchStatsId"]))

# Cambiar los tipos de datos de las columnas


df["Win"] = df["Win"].astype("int8")    # maneja valores de 1 y 0 como flags

for col in ["MinionsKilled", "kills", "deaths", "assists", "visionScore",
            "DragonKills", "BaronKills", "TurretDmgDealt"]:
    df[col] = pd.to_numeric(df[col], downcast="integer")


# convertir ID's numéricos a string para que no se consideren en operaciones matemáticas
ids = ["MatchStatsId", "SummonerMatchFk", "EnemyChampionFk", 
      "PrimaryKeyStone","PrimarySlot1", "PrimarySlot2", "PrimarySlot3", "SecondarySlot1",
      "SecondarySlot2", "SummonerSpell1", "SummonerSpell2"]

for col in ids:
  df[col] = df[col].astype("str")

# ==========================================
# BLOQUE 4: AGREGACIONES DE NEGOCIO
# ==========================================

# 1. Cual es la línea más jugada de todas
partidas_por_lane = (df.groupby("Lane")
                       .size()
                       .sort_values(ascending=False)
                       .rename("partidas"))

print(partidas_por_lane)
print(f"Lane más jugada: {partidas_por_lane.idxmax()} ({partidas_por_lane.max():,} partidas)")



# 2. Promedio de oro por lane 
avg_gold_lane = (df.groupby("Lane")["TotalGold"]
                  .mean()
                  .round(1)
                  .sort_values(ascending=False))
print(avg_gold_lane)


# 3. Daño total realizado por linea en 10 partidas

dmg_lane = (df.head(10)
            .groupby("Lane")["DmgDealt"]
            .sum()
            )

print(dmg_lane)

